# RITA demo proxy — environment template.
# Copy to a file OUTSIDE the repo (e.g. /home/akmaier/rita-demo.env), `chmod 600` it,
# fill in the real values, and point the systemd unit's EnvironmentFile at it.
# NEVER commit real keys. This .example file is the only env file that belongs in git.

# --- model access (NVIDIA NIM, OpenAI-compatible endpoint) ---
NIM_API_KEY=                                   # <-- SECRET: your NVIDIA NIM API key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b    # confirm the exact catalog id before go-live
NIM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
NIM_TEMPERATURE=0.2
NIM_MAX_TOKENS=256
MODEL_DISPLAY=NVIDIA Nemotron-3-Ultra-550B

# --- Cloudflare Turnstile (bot challenge) — required for a public endpoint ---
TURNSTILE_SITEKEY=                             # public site key (served to the page)
TURNSTILE_SECRET=                              # <-- SECRET: server-side verify key
# In production leave the next line unset. /api/classify FAILS CLOSED (503) when the
# Turnstile secret is missing — set this to 1 only for local dev without a challenge.
ALLOW_INSECURE_NO_TURNSTILE=

# --- trust boundary (shared host) ---
# The box also runs other apps; bind-to-localhost is not enough. Apache injects an
# X-Rita-Proxy header with this value; the app rejects /api/classify without it, so a
# co-tenant/SSRF can't hit 127.0.0.1:8090 directly. Use a long random string and put the
# SAME value in deploy/apache-rita.conf's `RequestHeader set X-Rita-Proxy`.
PROXY_SHARED_SECRET=                           # <-- SECRET: long random nonce

# --- abuse controls ---
MAX_BODY_BYTES=32768                           # reject larger request bodies before parsing
MAX_INPUT_CHARS=4000                           # per passage
MAX_BATCH_PASSAGES=20                          # whole-interview mode: passages per /api/classify_batch call
BATCH_WALL_SECONDS=45                          # stop a batch before Apache's proxy timeout; rest reported as skipped
RATE_PER_MIN=6                                 # per client IP
RATE_PER_DAY=100                               # per client IP
DAILY_CALL_CAP=3000                            # global/day — hard budget breaker
MAX_TRACKED_IPS=20000                          # rate-limiter memory bound
ALLOWED_ORIGIN=https://akmaier.github.io       # the demo page's origin (GitHub Pages). Set to the exact Pages origin; use https://lme245.cs.fau.de only if serving the page from lme245.
KILL_FILE=/home/akmaier/rita-demo/DISABLED     # `touch` this file to disable instantly; `rm` to re-enable
LOG_SALT=                                      # SECRET salt for hashed IPs in logs; random per-process if unset

# --- paths (usually leave as default) ---
# CATEGORIES_PATH=/home/akmaier/rita-demo/server/categories.json
# WEB_DIR=/home/akmaier/rita-demo/web
